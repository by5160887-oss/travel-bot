// Synthetic official search result for network-free regression tests.
export function officialSearch(url) {
 if(!String(url).includes('api.tavily.com')) return null;
 return {ok:true,status:200,json:async()=>({results:[{url:'https://www.icao.int/example-test-fixture',title:'Synthetic official source for tests',content:'Test fixture only: Montreal Convention Articles 17, 22, 31, 35. 21 days, 7 days, 2 years, 1519 SDR. Official authoritative test fixture, not a real claim.'}]})};
}
